#!/usr/bin/env bash
#
# pre-push hook for noesis_wgpu: rustfmt, clippy (-D warnings), and the tests,
# before a push reaches the remote.
#
# Activate per clone:
#   git config core.hooksPath scripts/git-hooks
#
# The no-shim checks need no SDK and always run. The `shim` checks link the
# Noesis SDK and run only when NOESIS_SDK_DIR points at one.
#
# Bypass in an emergency with:  git push --no-verify

set -uo pipefail

# Skip when the push only deletes refs (local sha is all-zero). Reading stdin
# also drains the ref list git feeds the hook.
zero="0000000000000000000000000000000000000000"
lines=0
deleting_only=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    lines=$((lines + 1))
    case "${local_sha:-}" in
        "" | "$zero") ;;
        *) deleting_only=0 ;;
    esac
done
if [ "$lines" -gt 0 ] && [ "$deleting_only" -eq 1 ]; then
    exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0
run() {
    echo "pre-push: running: $*"
    if ! "$@"; then
        echo "pre-push: FAILED: $*"
        fail=1
    fi
}

run cargo fmt --all --check
run cargo clippy --all-targets --no-default-features -- -D warnings
run cargo test --no-default-features

if [ -n "${NOESIS_SDK_DIR:-}" ] && [ -d "${NOESIS_SDK_DIR}/Include" ]; then
    run cargo clippy --all-targets --all-features -- -D warnings
    run cargo test --all-features
else
    echo "pre-push: NOESIS_SDK_DIR not set or missing Include/ -- skipping the shim checks."
fi

if [ "$fail" -ne 0 ]; then
    echo "pre-push: checks failed -- push aborted."
    echo "pre-push: fix the above, or bypass with 'git push --no-verify'."
    exit 1
fi

echo "pre-push: all checks passed."
exit 0
